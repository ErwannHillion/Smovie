# Copier vers .env et completer. Aucune de ces variables n'est lue par le code :
# tout passe par config/runtime.exs puis Smovie.Config.

# --- TMDB : catalogue, images, casting. OBLIGATOIRE. ---
# Cle gratuite sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=fr-FR
TMDB_REGION=FR

# --- OMDb : notes presse IMDb, Metacritic, Rotten Tomatoes. Optionnel. ---
# Cle gratuite sur https://www.omdbapi.com/apikey.aspx — quota 1000 req/jour.
# A false, l'application affiche la note TMDB seule, sans erreur visible.
OMDB_IS_ACTIVE=false
OMDB_API_KEY=your-omdb-api-key
OMDB_BASE_URL=https://www.omdbapi.com
OMDB_DAILY_QUOTA=1000

# --- Classements et notation ---
# Fenetre de calcul des tendances, en jours.
TRENDING_WINDOW_DAYS=7
# Nombre minimum de signaux sur la fenetre pour entrer au classement.
TRENDING_MIN_VOTES=3
# Poids de l'a priori de la moyenne bayesienne (en nombre de votes).
RATINGS_PRIOR_VOTES=20
# Nombre de reviews populaires affichees sur une fiche.
POPULAR_REVIEWS_LIMIT=5
# Longueur minimale d'une review pour etre eligible aux reviews populaires.
REVIEWS_MIN_BODY_LENGTH=80

# --- Langues ---
DEFAULT_LOCALE=fr
LOCALES=fr,en

# --- Base de donnees (developpement) ---
# Valeurs par defaut si absentes : postgres / postgres / localhost / smovie_dev
POSTGRES_USR=postgres
POSTGRES_PASSWD=postgres
POSTGRES_HOSTNAME=localhost
POSTGRES_DBNAME=smovie_dev
POSTGRES_POOL_SIZE=10

# --- Production uniquement ---
# DATABASE_URL=ecto://user:pass@host/smovie_prod
# SECRET_KEY_BASE=  # mix phx.gen.secret
# PHX_HOST=smovie.fr
# PHX_SERVER=true
